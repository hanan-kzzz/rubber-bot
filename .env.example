# ==========================================
# Rubber Business Telegram Bot Configuration
# ==========================================

# 1. Telegram Bot Token (from @BotFather)
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz

# 2. Access Control (Numeric Telegram IDs only - obtain from @userinfobot)
# Business owner with full admin control (wages, staff, all reports)
OWNER_ID=123456789

# Authorized staff members who can add transactions and view daily reports (comma-separated numeric IDs)
ALLOWED_STAFF_IDS=987654321,555444333

# 3. Google Apps Script Web App Integration
# The deployment URL from Google Apps Script Web App (ends with /exec)
GOOGLE_SCRIPT_URL=https://script.google.com/macros/s/AKfycbxXXXXXXXXXXXXXXXXXXXXXXXXXXXXX/exec

# Shared secret key defined in Google Apps Script to secure communication
GOOGLE_SCRIPT_SECRET=my_secure_rubber_bot_secret_2026

# 4. Server Configuration
PORT=3000

# Optional Webhook URL:
# For local testing, leave empty to use polling.
# On Render, this is auto-detected from RENDER_EXTERNAL_URL, or you can paste your Render app URL:
# WEBHOOK_DOMAIN=https://your-app-name.onrender.com
WEBHOOK_DOMAIN=
